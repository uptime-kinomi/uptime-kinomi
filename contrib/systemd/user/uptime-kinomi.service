# uptime-kinomi as a systemd *user* service: no root needed (SPEC.md §10.6).
#
#   install -m 755 uptime-kinomi-<platform> ~/.local/bin/uptime-kinomi
#   cp uptime-kinomi.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now uptime-kinomi
#
# To run while you are logged out and to start at boot, lingering must be
# enabled once for your user: loginctl enable-linger
#
# Configuration: ~/.config/uptime-kinomi/
# State and logs: ~/.local/state/uptime-kinomi/ (logs in log/)
# Pages: /run/user/<uid>/uptime-kinomi/www/ (a tmpfs; regenerated after a reboot)
#
# The unit sets no directories on purpose: kinomi derives them from the
# user alone, so "systemctl --user stop uptime-kinomi" followed by a manual
# "uptime-kinomi run" uses exactly the same directories and port
# (SPEC.md §10.6).

[Unit]
Description=uptime-kinomi uptime monitor
Documentation=https://github.com/uptime-kinomi/uptime-kinomi

[Service]
ExecStart=%h/.local/bin/uptime-kinomi run
Restart=on-failure
RestartSec=10
# Checks first, page rendering and everything else second.
Nice=10
# No StateDirectory=/LogsDirectory=/RuntimeDirectory= (see above). Also,
# for user units systemd >= 255 would "migrate" ~/.config/<name> for
# StateDirectory= by linking ~/.local/state/<name> to it.
NoNewPrivileges=yes
UMask=0027

[Install]
WantedBy=default.target
